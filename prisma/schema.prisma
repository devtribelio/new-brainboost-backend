model Topic {
  id          String   @id @default(uuid(7)) @db.Uuid
  legacyId    Int?     @unique @map("legacy_id")
  networkId   String?  @map("network_id") @db.Uuid
  name        String
  description String?
  iconUrl     String?  @map("icon_url")
  iconType    String?  @map("icon_type") // "emoji" | "image" — null when no icon
  type        String   @default("PUBLIC")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  network       Network?            @relation(fields: [networkId], references: [id], onDelete: Cascade)
  posts         Post[]
  subscriptions TopicSubscription[]
  joinRequests  TopicJoinRequest[]

  @@index([networkId])
  @@index([name])
  @@map("topics")
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model TopicJoinRequest {
  id        String            @id @default(uuid(7)) @db.Uuid
  topicId   String            @map("topic_id") @db.Uuid
  memberId  String            @map("member_id") @db.Uuid
  status    JoinRequestStatus @default(PENDING)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, memberId])
  @@index([memberId])
  @@map("topic_join_requests")
}

model TopicSubscription {
  id        String   @id @default(uuid(7)) @db.Uuid
  memberId  String   @map("member_id") @db.Uuid
  topicId   String   @map("topic_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  topic  Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([memberId, topicId])
  @@map("topic_subscriptions")
}

model Post {
  id            String    @id @default(uuid(7)) @db.Uuid
  legacyId      Int?      @unique @map("legacy_id")
  authorId      String    @map("author_id") @db.Uuid
  topicId       String?   @map("topic_id") @db.Uuid
  kindId        String?   @map("kind_id") @db.Uuid // post taxonomy (§4); server fills the default kind when omitted
  networkId     String?   @map("network_id") @db.Uuid
  title         String?
  content       String
  excerpt       String?
  postType      String?   @map("post_type")
  imageUrls     String[]  @map("image_urls")
  videoUrl      String?   @map("video_url")
  embedUrl      String?   @map("embed_url")
  publishStatus String    @default("PUBLISHED") @map("publish_status")
  publishAt     DateTime? @map("publish_at")
  countLike     Int       @default(0) @map("count_like")
  countComment  Int       @default(0) @map("count_comment")
  countReplies  Int       @default(0) @map("count_replies")
  viewCount     Int       @default(0) @map("view_count")
  isPinned      Boolean   @default(false) @map("is_pinned")
  isCurated     Boolean   @default(false) @map("is_curated")
  isAdminPost   Boolean   @default(false) @map("is_admin_post")
  engagedAt     DateTime? @map("engaged_at")
  isDeleted     Boolean   @default(false) @map("is_deleted")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  author   Member       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  topic    Topic?       @relation(fields: [topicId], references: [id])
  kind     PostKind?    @relation(fields: [kindId], references: [id])
  comments Comment[]
  likes    PostLike[]
  reports  PostReport[]

  @@index([authorId])
  @@index([topicId])
  @@index([kindId])
  @@map("posts")
}

// Post kind taxonomy (§4 / BB-116) — "Testimoni | Tips | Diskusi | Progress | Tanya".
// BE-sourced (like topics) so product can tune the list without an app release.
// Exactly one row carries isDefault: the kind applied server-side when a client
// omits kindId (old app versions keep working). Seeded by the migration with
// fixed UUIDs so ids are identical across envs — FE caches them client-side.
model PostKind {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String // display label, e.g. "Diskusi"
  slug      String   @unique // stable machine key, e.g. "diskusi"
  sortOrder Int      @default(0) @map("sort_order") // array order = display order
  isDefault Boolean  @default(false) @map("is_default") // applied when kindId is omitted
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  posts Post[]

  @@index([isActive, sortOrder])
  @@map("post_kinds")
}

// Registry of every object written to S3 by the upload endpoint (§4 / BB-116).
// Exists so orphaned uploads (uploaded, then the post was never created) can be
// swept: a row with referencedAt = NULL older than the TTL is a deletion
// candidate. NO FK to Member on purpose — mirrors ListeningSession: this is a
// cheap ingest log, an upload must never fail because of a FK, and cascading a
// member delete would strand the S3 objects with no row left to sweep them.
model UploadedFile {
  id            String    @id @default(uuid(7)) @db.Uuid
  key           String    @unique // S3 object key — identity, used by deleteObject
  publicUrl     String    @map("public_url") // CDN URL handed to the client
  ownerId       String    @map("owner_id") @db.Uuid // uploading member (no FK by design)
  kind          String // UPLOAD_KINDS: avatar|cover|post|comment|network|general
  fileName      String?   @map("file_name") // original client filename (audit)
  mimeType      String    @map("mime_type")
  sizeBytes     Int       @map("size_bytes")
  referencedAt  DateTime? @map("referenced_at") // NULL = orphan candidate
  referenceType String?   @map("reference_type") // "post" | … what claimed it
  referenceId   String?   @map("reference_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([referencedAt, createdAt]) // sweep query
  @@index([ownerId, createdAt])
  @@map("uploaded_files")
}

model PostLike {
  id        String   @id @default(uuid(7)) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  memberId  String   @map("member_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([postId, memberId])
  @@map("post_likes")
}

model PostReport {
  id           String       @id @default(uuid(7)) @db.Uuid
  postId       String       @map("post_id") @db.Uuid
  reporterId   String       @map("reporter_id") @db.Uuid
  categoryId   String       @map("category_id") @db.Uuid
  networkId    String?      @map("network_id") @db.Uuid
  reason       String?
  reportStatus ReportStatus @default(REPORTED) @map("report_status")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  post     Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  category ReportCategory @relation(fields: [categoryId], references: [id])

  @@index([postId])
  @@map("post_reports")
}

model Comment {
  id           String   @id @default(uuid(7)) @db.Uuid
  legacyId     Int?     @unique @map("legacy_id")
  postId       String   @map("post_id") @db.Uuid
  authorId     String   @map("author_id") @db.Uuid
  parentId     String?  @map("parent_id") @db.Uuid
  content      String
  countLike    Int      @default(0) @map("count_like")
  countReplies Int      @default(0) @map("count_replies")
  isCurated    Boolean  @default(false) @map("is_curated")
  isDeleted    Boolean  @default(false) @map("is_deleted")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  post    Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  Member        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[]     @relation("CommentReplies")
  likes   CommentLike[]

  @@index([postId])
  @@index([parentId])
  @@map("comments")
}

model CommentLike {
  id        String   @id @default(uuid(7)) @db.Uuid
  commentId String   @map("comment_id") @db.Uuid
  memberId  String   @map("member_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([commentId, memberId])
  @@map("comment_likes")
}

model Network {
  id          String   @id @default(uuid(7)) @db.Uuid
  legacyId    Int?     @unique @map("legacy_id")
  code        String?  @unique
  name        String
  purpose     String? // "timeline" | "education" | null — used by /member/info community list
  description String?
  iconUrl     String?  @map("icon_url")
  countMember Int      @default(0) @map("count_member")
  isPublic    Boolean  @default(true) @map("is_public")
  isHelpdesk  Boolean  @default(false) @map("is_helpdesk")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members        NetworkMember[]
  memberRequests NetworkMemberRequest[]
  bannedMembers  NetworkBannedMember[]
  tags           NetworkTag[]
  topics         Topic[]

  @@index([name])
  @@map("networks")
}

model NetworkMemberRequest {
  id        String            @id @default(uuid(7)) @db.Uuid
  networkId String            @map("network_id") @db.Uuid
  memberId  String            @map("member_id") @db.Uuid
  status    JoinRequestStatus @default(PENDING)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  network Network @relation(fields: [networkId], references: [id], onDelete: Cascade)

  @@unique([networkId, memberId])
  @@index([memberId])
  @@map("network_member_requests")
}

model NetworkBannedMember {
  id        String   @id @default(uuid(7)) @db.Uuid
  networkId String   @map("network_id") @db.Uuid
  memberId  String   @map("member_id") @db.Uuid
  reason    String?
  bannedAt  DateTime @default(now()) @map("banned_at")

  network Network @relation(fields: [networkId], references: [id], onDelete: Cascade)

  @@unique([networkId, memberId])
  @@map("network_banned_members")
}

model NetworkTeamMember {
  id        String   @id @default(uuid(7)) @db.Uuid
  networkId String   @map("network_id") @db.Uuid
  memberId  String   @map("member_id") @db.Uuid
  role      String   @default("MODERATOR")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([networkId, memberId])
  @@index([memberId])
  @@map("network_team_members")
}

model NetworkMember {
  id        String   @id @default(uuid(7)) @db.Uuid
  legacyId  Int?     @unique @map("legacy_id")
  networkId String   @map("network_id") @db.Uuid
  memberId  String   @map("member_id") @db.Uuid
  joinedAt  DateTime @default(now()) @map("joined_at")
  // Per-network moderation flag. Set by team/admin to silence a member in this
  // tribe without removing them. Blocks post create, comment, and like.
  // Mirrors legacy TBApi::validateMemberMuteNetwork.
  isMuted   Boolean  @default(false) @map("is_muted")
  updatedAt DateTime @updatedAt @map("updated_at")

  network Network @relation(fields: [networkId], references: [id], onDelete: Cascade)

  @@unique([networkId, memberId])
  @@map("network_members")
}

model NetworkTag {
  id        String   @id @default(uuid(7)) @db.Uuid
  networkId String   @map("network_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  network Network @relation(fields: [networkId], references: [id], onDelete: Cascade)

  @@unique([networkId, name])
  @@map("network_tags")
}

