}

// ============================================================================
// Notification
// ============================================================================

model Notification {
  id         String    @id @default(uuid(7)) @db.Uuid
  memberId   String    @map("member_id") @db.Uuid
  networkId  String?   @map("network_id") @db.Uuid
  /// Topic this notification originates from. Denormalised out of `payload` so the
  /// nightly digest can group unread rows per topic with an indexed query instead
  /// of digging through JSON. Only `newPost` sets it today.
  topicId    String?   @map("topic_id") @db.Uuid
  type       String
  notifGroup String?   @map("notif_group")
  title      String
  body       String?
  payload    Json?
  url        String?
  dedupeKey  String?   @unique @map("dedupe_key")
  seenAt     DateTime? @map("seen_at")
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, readAt])
  @@index([memberId, networkId])
  @@index([memberId, seenAt])
  // Digest sweep: unread rows of one type, grouped per member+topic.
  @@index([type, readAt, topicId])
  @@map("notifications")
}

model NotificationMute {
  memberId  String   @map("member_id") @db.Uuid
  scope     String
  refId     String   @map("ref_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([memberId, scope, refId])
  @@index([scope, refId])
  @@map("notification_mutes")
}

