generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Member / auth
// ============================================================================

model Member {
  id                   String    @id @default(uuid(7)) @db.Uuid
  legacyId             Int?      @unique @map("legacy_id")
  code                 String?   @unique
  email                String?   @unique
  username             String?   @unique
  phone                String?   @unique
  phoneCode            String?   @map("phone_code")
  fullName             String?   @map("full_name")
  passwordHash         String    @map("password_hash")
  passwordAlgo         String    @default("bcrypt") @map("password_algo")
  googleSub            String?   @unique @map("google_sub")
  appleSub             String?   @unique @map("apple_sub")
  avatarUrl            String?   @map("avatar_url")
  coverUrl             String?   @map("cover_url")
  bio                  String?
  isActive             Boolean   @default(true) @map("is_active")
  isEmailVerified      Boolean   @default(false) @map("is_email_verified")
  isPhoneVerified      Boolean   @default(false) @map("is_phone_verified")
  isMuted              Boolean   @default(false) @map("is_muted")
  isBanned             Boolean   @default(false) @map("is_banned")
  gender               String?
  birthdate            DateTime?
  affiliateCode        String?   @unique @map("affiliate_code")
  affiliateBased       String    @default("PERFORMANCE") @map("affiliate_based") // "PERFORMANCE" | "GROWTH" | "INACTIVE"
  inviterId            String?   @map("inviter_id") @db.Uuid
  utmSource            String?   @map("utm_source")
  utmContent           String?   @map("utm_content")
  scheduledDeletionAt  DateTime? @map("scheduled_deletion_at")
  lastActiveAt         DateTime? @map("last_active_at")
  latitude             Float?
  longitude            Float?
  notificationsEnabled Boolean   @default(true) @map("notifications_enabled")
  /// Push sent since the member last opened the app; reset to 0 on app resume
  /// (/member/info touchActivity) and on /notification/seen. Once it passes
  /// `notification.unopenedPushLimit` (app_settings) further push is suppressed —
  /// the notification ROW is still written, only FCM delivery is skipped.
  unopenedPushCount    Int       @default(0) @map("unopened_push_count")
  /// Watermark for the nightly topic digest: only unread `newPost` rows created
  /// after this are counted, so a member is never told twice about the same post.
  /// null = never digested (counts everything unread).
  lastTopicDigestAt    DateTime? @map("last_topic_digest_at")

  // --- Affiliate payout: default bank account stored on the profile (manual KYC flow) ---
  bankCode          String? @map("bank_code")
  bankAccountNumber String? @map("bank_account_number")
  bankAccountName   String? @map("bank_account_name")

  // --- Manual KYC (gate for affiliate disbursement) ---
  kycStatus         String    @default("NONE") @map("kyc_status") // NONE | PENDING | APPROVED | REJECTED | EXPIRED
  // EXPIRED = previously APPROVED but a risk event (bank change / dormant reactivation /
  // large disbursement / suspicious) forced a re-KYC. Treated as NOT-approved by the
  // disbursement gate; member must re-verify before the next payout. See docs/kyc-rekyc.md.
  // Provenance of the current kycStatus: NONE (never KYC'd) | LEGACY (imported from
  // legacy member_data_kyc — no provider session / images live in legacy S3) |
  // MANUAL (admin-reviewed manual flow) | DIDIT (driven by Didit webhook).
  kycSource         String    @default("NONE") @map("kyc_source")
  kycIdNumber       String?   @map("kyc_id_number")
  // Document kind behind kycIdNumber, stored VERBATIM as the provider labels it
  // ("Identity Card" / "Passport" / "Driver's License" / ...). Free-form on purpose:
  // mapping to a KTP|SIM|PASSPORT enum would guess at strings we have not seen from
  // every Didit workflow, and ops only needs to know which document the number is from.
  // null = unknown (manual submit, legacy import, or a decision without id_verifications).
  kycIdType         String?   @map("kyc_id_type")
  kycIdCardUrl      String?   @map("kyc_id_card_url")
  kycSelfieUrl      String?   @map("kyc_selfie_url")
  kycSubmittedAt    DateTime? @map("kyc_submitted_at")
  kycReviewedAt     DateTime? @map("kyc_reviewed_at")
  kycReviewedBy     String?   @map("kyc_reviewed_by") @db.Uuid
  kycRejectedReason String?   @map("kyc_rejected_reason")
  // Provider verification reference bound to this member. For Didit this is the
  // ACTIVE verification session_id (session-per-attempt). A provider webhook is
  // only honoured when its session_id matches this value — that guards against a
  // stale "Approved" webhook from an old session re-approving an EXPIRED member
  // (replaces Sumsub's resetApplicant call). See docs/kyc-rekyc.md.
  // null = KYC never went through an external provider (manual flow or none).
  kycProviderRef    String?   @unique @map("kyc_provider_ref")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Legacy resync (new-wins-on-touch): the timestamp the resync last wrote this row.
  // If updatedAt > legacySyncedAt, the app touched the row since → legacy-owned fields
  // are NOT overwritten. null = never resynced (treat as legacy-owned). See
  // docs/legacy-resync-plan.md §6.
  legacySyncedAt DateTime? @map("legacy_synced_at")

  /// Per-member override for the playlist cap. NULL = follow app_settings
  /// `playlist.maxPerMember`. -1 = unlimited, 0 = may not create any at all
  /// (0 is NOT unlimited). Only ops writes this; there is no member-facing route.
  playlistQuota Int? @map("playlist_quota")

  profile                MemberProfile?
  devices                Device[]
  refreshTokens          RefreshToken[]
  posts                  Post[]
  comments               Comment[]
  notifications          Notification[]
  topicSubs              TopicSubscription[]
  postLikes              PostLike[]
  commentLikes           CommentLike[]
  inviter                Member?                       @relation("MemberInviter", fields: [inviterId], references: [id])
  invitees               Member[]                      @relation("MemberInviter")
  memberAffiliators      MemberAffiliator[]            @relation("MemberAffiliatorMember")
  affiliateCommissions   AffiliateCommission[]         @relation("AffiliateCommissionRecipient")
  affiliateVisits        AffiliateVisit[]              @relation("AffiliateVisitAffiliator")
  affiliateDisbursements AffiliateDisbursement[]       @relation("MemberDisbursements")
  leaderboardEntries     AffiliateLeaderboardMonthly[] @relation("MemberLeaderboardEntries")
  courseEnrollments      CourseEnrollment[]
  commerceTransactions   CommerceTransaction[]
  commercePayments       CommercePayment[]
  notificationMutes      NotificationMute[]
  kycEvents              KycEvent[]
  ownedSubscriptions     MemberSubscription[]          @relation("MemberSubscriptionOwner")
  subscriptionSeats      SubscriptionSeat[]            @relation("SubscriptionSeatMember")
  playlists              Playlist[]                    @relation("PlaylistOwner")

  @@map("members")
}

// Audit trail for every KYC status transition (AML). Writes are append-only;
// the Member.kyc* columns hold the current state, this holds the history.
// See docs/kyc-rekyc.md.
model KycEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  memberId   String   @map("member_id") @db.Uuid
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  type       String // RESET | SUBMIT | PENDING | APPROVE | REJECT
  reason     String? // BANK_CHANGE | DORMANT_REACTIVATION | LARGE_DISBURSEMENT | SUSPICIOUS | ADMIN_MANUAL
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  actorType  String   @map("actor_type") // SYSTEM | ADMIN | DIDIT
  actorId    String?  @map("actor_id") @db.Uuid
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([memberId, createdAt])
  @@map("kyc_event")
}

model MemberProfile {
  id         String   @id @default(uuid(7)) @db.Uuid
  memberId   String   @unique @map("member_id") @db.Uuid
  countryId  String?  @map("country_id") @db.Uuid
  provinceId String?  @map("province_id") @db.Uuid
  cityId     String?  @map("city_id") @db.Uuid
  districtId String?  @map("district_id") @db.Uuid
  address    String?
  postalCode String?  @map("postal_code")
  updatedAt  DateTime @updatedAt @map("updated_at")

  member   Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  country  Country?  @relation(fields: [countryId], references: [id])
  province Province? @relation(fields: [provinceId], references: [id])
  city     City?     @relation(fields: [cityId], references: [id])
  district District? @relation(fields: [districtId], references: [id])

  @@map("member_profiles")
}

model Device {
  id         String   @id @default(uuid(7)) @db.Uuid
  memberId   String   @map("member_id") @db.Uuid
  deviceId   String   @map("device_id")
  platform   String
  fcmToken   String?  @map("fcm_token")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, deviceId])
  @@map("devices")
}

model RefreshToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  memberId   String    @map("member_id") @db.Uuid
  token      String    @unique
  clientType String    @default("mobile") @map("client_type")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  /// Lineage pointer to the row that replaced this one on refresh rotation.
  /// Set ONLY by rotation — logout / password change / single-session kick all
  /// revoke without a successor. That asymmetry is what makes the refresh grace
  /// window safe: a revoked row is eligible for grace only when this is filled,
  /// so deliberate revocation still kicks instantly. Deliberately a plain
  /// scalar, no FK: rotation writes this pointer in the same transaction that
  /// gates the race, BEFORE the child row exists.
  supersededById String? @unique @map("superseded_by_id") @db.Uuid

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([memberId, clientType, revokedAt])
  @@map("refresh_tokens")
}

model OtpCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  target    String
  code      String
  purpose   String
  attempts  Int       @default(0)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([target, purpose])
  @@map("otp_codes")
}

/// Outbound message outbox (transactional). Producer writes a row in the same
/// transaction as the domain mutation; the comms-relay daemon polls PENDING and
/// publishes to RabbitMQ → at-least-once, no dual-write race. The row id is the
/// message id used downstream for idempotency (bb-comms). Serves external comms
/// now (whatsapp/email/sms) and is forward-compatible with FCM push.
/// See docs/adr/0002 + docs/email-scope.md §4.
model NotificationOutbox {
  id          String    @id @default(uuid(7)) @db.Uuid
  /// Template/handler discriminator: 'otp' | 'CoursePaymentSuccess' | …
  type        String
  /// 'whatsapp' | 'email' | 'sms' | (future) 'fcm'
  channel     String
  /// 'urgent' | 'normal' — maps to the RabbitMQ routing key / queue tier.
  priority    String    @default("normal")
  /// Entity id the worker reads bb-platform PG by (transactional types).
  refId       String?   @map("ref_id")
  /// Direct recipient when no PG lookup (OTP: phone/email).
  recipient   String?
  /// Inline data. OTP only: { code, name?, ttl? } (otp_codes holds only the hash).
  payload     Json?
  status      String    @default("PENDING") /// PENDING | SENT | FAILED
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  scheduledAt DateTime  @default(now()) @map("scheduled_at")
  sentAt      DateTime? @map("sent_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([status, scheduledAt])
  @@map("notification_outbox")
}

/// Delivery log — comms-owned (written by bb-comms), declared here because
/// bb-platform schema.prisma is the single migration authority (ADR-0001).
/// One row per send attempt (SENT | FAILED) for observability/audit.
model CommsDelivery {
  // DB-level default: this table is written by bb-comms via Kysely (not Prisma),
  // so the id must be generated by Postgres, not the Prisma client.
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId        String   @map("message_id") /// = NotificationOutbox.id
  channel          String
  type             String
  recipient        String?
  status           String /// SENT | FAILED
  providerResponse String?  @map("provider_response")
  attempt          Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([messageId])
  @@map("comms_delivery")
}

/// Idempotency guard — comms-owned (written by bb-comms). One row per message
/// that was successfully delivered; blocks at-least-once redelivery double-sends.
model CommsIdempotency {
  messageId String   @id @map("message_id")
  sentAt    DateTime @default(now()) @map("sent_at")

  @@map("comms_idempotency")
}

model PraMember {
  id                 String   @id @default(uuid(7)) @db.Uuid
  email              String?
  phone              String?
  affiliateMemberId  String?  @map("affiliate_member_id") @db.Uuid
  networkId          String?  @map("network_id") @db.Uuid
  device             Json?
  /// Full attribution context captured at pre-registration: programCode, utm_*,
  /// adId, adNetwork, installReferrer, deviceId, platform, appVersion.
  /// Carried to the register step so AffiliateVisit can be created with full
  /// marketing fidelity bound to the new Member.id.
  attributionContext Json?    @map("attribution_context")
  expiresAt          DateTime @map("expires_at")
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([email])
  @@index([phone])
  @@map("pra_members")
}

// ============================================================================
// Location
// ============================================================================

model Country {
  id        String          @id @default(uuid(7)) @db.Uuid
  legacyId  Int?            @unique @map("legacy_id")
  name      String
  code      String?         @unique
  updatedAt DateTime        @updatedAt @map("updated_at")
  provinces Province[]
  profiles  MemberProfile[]

  @@map("countries")
}

model Province {
  id        String          @id @default(uuid(7)) @db.Uuid
  legacyId  Int?            @unique @map("legacy_id")
  countryId String          @map("country_id") @db.Uuid
  name      String
  updatedAt DateTime        @updatedAt @map("updated_at")
  cities    City[]
  country   Country         @relation(fields: [countryId], references: [id])
  profiles  MemberProfile[]

  @@index([countryId])
  @@map("provinces")
}

model City {
  id         String          @id @default(uuid(7)) @db.Uuid
  legacyId   Int?            @unique @map("legacy_id")
  provinceId String          @map("province_id") @db.Uuid
  name       String
  updatedAt  DateTime        @updatedAt @map("updated_at")
  districts  District[]
  province   Province        @relation(fields: [provinceId], references: [id])
  profiles   MemberProfile[]

  @@index([provinceId])
  @@map("cities")
}

model District {
  id        String          @id @default(uuid(7)) @db.Uuid
  legacyId  Int?            @unique @map("legacy_id")
  cityId    String          @map("city_id") @db.Uuid
  name      String
  updatedAt DateTime        @updatedAt @map("updated_at")
  city      City            @relation(fields: [cityId], references: [id])
  profiles  MemberProfile[]

  @@index([cityId])
  @@map("districts")
}

// ============================================================================
// Banner & product
// ============================================================================

model Banner {
  id        String    @id @default(uuid(7)) @db.Uuid
  legacyId  Int?      @unique @map("legacy_id")
  title     String
  imageUrl  String    @map("image_url")
  linkUrl   String?   @map("link_url")
  position  Int       @default(0)
  isActive  Boolean   @default(true) @map("is_active")
  isPopup   Boolean   @default(false) @map("is_popup")
  startedAt DateTime? @map("started_at") // window open; null = no lower bound
  endedAt   DateTime? @map("ended_at") // window close; null = no upper bound
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("banners")
}

model Product {
  id               String   @id @default(uuid(7)) @db.Uuid
  legacyId         Int?     @unique @map("legacy_id")
  iosProductId     String?  @unique @map("ios_product_id") // App Store SKU → resolves a provider product_id (e.g. RevenueCat) to this Product
  androidProductId String?  @unique @map("android_product_id") // Play Store SKU → resolves a provider product_id (e.g. RevenueCat) to this Product
  type             String
  code             String?  @unique // legacy `course.code` — short alphanumeric id
  slug             String? // SEO-friendly slug from legacy `course.slug`
  title            String
  description      String?
  thumbnail        String? // legacy resource (model_type=TBModel_Course, collection=courseImage)
  price            Int      @default(0)
  iosPrice         Int?     @map("ios_price") // gross iOS IAP price (marked up to offset Apple's cut); null = same as `price`. Used for the affiliate commission range preview.
  marketingLink    String?  @map("marketing_link") // legacy `course.marketing_link`
  sellingPoints    Json?    @map("selling_points") // legacy `course.selling_point` — JSONB string[]
  status           String   @default("active") // legacy: active|inactive|draft|archived
  tags             String? // legacy `course.tags` raw csv
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  course               Course?
  reviews              Review[]
  affiliatePrograms    AffiliateProgram[]
  affiliateCommissions AffiliateCommission[]
  commerceTransactions CommerceTransaction[]
  subscriptionPlan     SubscriptionPlan?
  voucherProducts      VoucherProduct[]

  @@map("products")
}

model Course {
  id             String   @id @default(uuid(7)) @db.Uuid
  productId      String   @unique @map("product_id") @db.Uuid
  legacyCourseId Int?     @unique @map("legacy_course_id") // legacy `course.id` int — emitted as `courseLegacyId` in response
  durationMin    Int      @default(0) @map("duration_min")
  programDays    Int      @default(30) @map("program_days") // listening-challenge duration in days (90/60/30); challenge `target`
  updatedAt      DateTime @updatedAt @map("updated_at")

  product     Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  sections    CourseSection[]
  enrollments CourseEnrollment[]
  bonuses     CourseBonus[]

  @@map("courses")
}

// Bonus attachments (PDF workbooks etc.) shown on the course detail screen.
// NEW feature (no legacy counterpart → intentionally no `legacyId`). Files live
// under the S3 `private/` prefix; `fileKey` is server-only and never leaves the
// backend — clients get an opaque `bonusId` and mint a short-lived presigned URL
// via POST /member/course/bonus/:bonusId/access-url. Upload/ingestion is done by
// backoffice-bb (raw SQL INSERT + S3 write); this backend owns the read/gate side.
model CourseBonus {
  id           String   @id @default(uuid(7)) @db.Uuid
  courseId     String   @map("course_id") @db.Uuid
  title        String
  fileName     String   @map("file_name") // original name — shown to user + Content-Disposition
  fileKey      String   @map("file_key") // S3 key under private/ — NEVER exposed to the client
  sizeBytes    Int      @map("size_bytes") // FE needs it for the >20MB progress UI
  mimeType     String   @default("application/pdf") @map("mime_type")
  downloadable Boolean  @default(true) // false = view-only in-app
  sortOrder    Int      @default(0) @map("sort_order") // display order within a course
  isActive     Boolean  @default(true) @map("is_active") // soft-hide without deleting the S3 object
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, sortOrder])
  @@map("course_bonuses")
}

model CourseEnrollment {
  id                 String    @id @default(uuid(7)) @db.Uuid
  legacyId           Int?      @unique @map("legacy_id")
  memberId           String    @map("member_id") @db.Uuid
  courseId           String    @map("course_id") @db.Uuid
  progress           Float     @default(0)
  dateStart          DateTime? @map("date_start")
  dateEnd            DateTime? @map("date_end")
  expiredDate        DateTime? @map("expired_date")
  // TWO independent grant markers. Both mean the same thing structurally: the row
  // is time-boxed and `expiredDate` MUST be honoured. Both NULL = retail/legacy
  // row, which access gates must treat as ALWAYS valid REGARDLESS of expiredDate —
  // the legacy migration filled expired_date on lifetime purchases, so honouring it
  // globally would cut off paying buyers. Neither has an FK by design (mirrors
  // AffiliateAttributionClaim): the enrollment must not be deleted or locked by the
  // subscription lifecycle, nor by deleting a voucher.
  //
  // Lazy-enrollment marker: auto-created/refreshed by an active subscription
  // (expiredDate mirrors sub.expiresAt; renewal bumps it).
  viaSubscriptionId  String?   @map("via_subscription_id") @db.Uuid
  // Free-trial marker: granted by a `type='TRIAL'` voucher
  // (expiredDate = grant time + voucher.trialDays).
  viaVoucherId       String?   @map("via_voucher_id") @db.Uuid
  isCanceled         Boolean   @default(false) @map("is_canceled")
  cancelationReason  String?   @map("cancelation_reason")
  canceledAt         DateTime? @map("canceled_at")
  certificateCode    String?   @map("certificate_code")
  certificateCreated DateTime? @map("certificate_created")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([memberId, courseId])
  @@index([memberId, createdAt])
  @@index([viaSubscriptionId])
  @@index([viaVoucherId])
  @@map("course_enrollment")
}

model CourseSection {
  id              String   @id @default(uuid(7)) @db.Uuid
  legacySectionId Int      @unique @default(autoincrement()) @map("legacy_section_id") // emit as `courseSectionId` int legacy
  courseId        String   @map("course_id") @db.Uuid
  name            String
  order           Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId, order])
  @@map("course_sections")
}

model Lesson {
  id             String   @id @default(uuid(7)) @db.Uuid
  legacyLessonId Int      @unique @default(autoincrement()) @map("legacy_lesson_id") // emit as `courseLessonId` int legacy
  sectionId      String   @map("section_id") @db.Uuid
  name           String // legacy `lessonName`
  description    String? // legacy `lessonDescription`
  slidesData     Json?    @map("slides_data") // legacy `course_lesson.slides_data` — array of slide objects
  code           String?  @unique // legacy `code`
  lessonStatus   String   @default("ACTIVE") @map("lesson_status") // legacy `lesson_status`
  isPreview      Boolean  @default(false) @map("is_preview") // legacy `is_preview` (emit as int 0/1)
  duration       Int      @default(0) // legacy `duration` seconds
  order          Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  section       CourseSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  playlistItems PlaylistItem[]

  @@index([sectionId, order])
  @@map("course_lessons")
}

model Review {
  id        String   @id @default(uuid(7)) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  memberId  String   @map("member_id") @db.Uuid
  stars     Int // 1..5, validated in service
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, memberId])
  @@index([productId, stars])
  @@map("reviews")
}

// ============================================================================
// Listening tracker (streak / sessions / total listen / challenge / recap)
// ============================================================================

// Append-only log of listening sessions emitted by the mobile audio player.
// All home-screen metrics (streak, sessions, total, challenge, weekly recap) are
// derived from this table at read-time (see tracker/stats.service.ts) — no
// pre-aggregation tables in MVP. No FK to Lesson/Course on purpose: this is a
// cheap ingest log and a write must never fail because a lesson row was removed.
model ListeningSession {
  id              String   @id @default(uuid(7)) @db.Uuid
  clientSessionId String   @map("client_session_id") @db.Uuid // generated on device at play-start → idempotency key
  memberId        String   @map("member_id") @db.Uuid
  // The `id` of the slide inside `course_lessons.slides_data` that was played —
  // NOT `Lesson.id`, despite what this comment claimed until 2026-08-25. Measured
  // on 148,644 rows: 0 match a Lesson.id, 125 of 132 distinct values match a slide
  // id (91% of sessions AudioTemplate, 9% VideoTemplate — an "audio" lesson is a
  // video of a still image, so both are listened to). Opaque string, no FK: this
  // is an ingest log and a write must never fail because a slide was edited away.
  audioId         String   @map("audio_id")
  courseId        String?  @map("course_id") @db.Uuid
  startedAt       DateTime @map("started_at") // UTC
  listenedSec     Int      @map("listened_sec") // seconds actually heard (not audio duration)
  completed       Boolean  @default(false)
  localDay        DateTime @map("local_day") @db.Date // LISTENING day (04:00 WIB boundary, not midnight) at write → trivial streak query
  source          String? // "ios" / "android/3.3.1+412" from x-platform, or synthetic "backfill:*" / "goodwill:*"
  // Playlist the audio was played from, when any. NULL = played standalone.
  // No FK on purpose, same reason as `audioId`: this is an ingest log and a write
  // must never fail because the playlist row was deleted. Feeds the recent/top
  // playlist lists, which are derived at read time (docs/playlist-port.md §7).
  playlistId      String?  @map("playlist_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([memberId, clientSessionId]) // dedup retry / resume re-send
  @@index([memberId, localDay])
  @@index([memberId, courseId, localDay])
  @@index([memberId, playlistId, startedAt])
  @@map("listening_session")
}

// ============================================================================
// Playlist (docs/playlist-port.md)
// ============================================================================

/// Member-built audio playlist. There is no curated/official variant — every row
/// belongs to a member (`ownerId` NOT NULL); if that ever changes, dropping the
/// NOT NULL is a trivial migration, so it is not pre-emptively nullable.
/// Playing/creating requires an active subscription (`playlist.requiresSubscription`).
model Playlist {
  id              String    @id @default(uuid(7)) @db.Uuid
  ownerId         String    @map("owner_id") @db.Uuid
  /// PRIVATE | UNLISTED — a playlist becomes reachable by others only through a
  /// share token its owner switched on. Free-form string, no DB enum (same posture
  /// as `members.kyc_status`): a new value must not need a members-table DDL.
  visibility      String    @default("PRIVATE")
  /// Opaque random share key, minted when sharing is switched on, NULL when off,
  /// rotatable. Deliberately NOT the id: a UUID v7 carries its creation timestamp
  /// and can never be revoked.
  shareToken      String?   @unique @map("share_token")
  sharedAt        DateTime? @map("shared_at")
  /// Share token this playlist was copied from — plain scalar, NO FK, so the source
  /// may be deleted without breaking the copy. Feeds analytics and, later, share
  /// commission attribution.
  copiedFromToken String?   @map("copied_from_token")
  /// Playlist this one was copied from — plain scalar, NO FK, same posture as
  /// `copiedFromToken`. It exists BESIDE the token because the token is not a stable
  /// handle: unshare clears it and rotate replaces it, so a copy made yesterday can no
  /// longer find its source today. The history merge needs a link that survives both,
  /// otherwise a saved playlist splits into two cards — the source carrying the plays,
  /// the copy carrying the ownership.
  copiedFromPlaylistId String? @map("copied_from_playlist_id") @db.Uuid
  name            String
  description     String?
  coverUrl        String?   @map("cover_url")
  sortOrder       Int       @default(0) @map("sort_order")
  isActive        Boolean   @default(true) @map("is_active")
  /// Ops moderation kill-switch. A blocked playlist answers 404, never 403 — a 403
  /// would confirm it exists.
  isBlocked       Boolean   @default(false) @map("is_blocked")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  owner Member         @relation("PlaylistOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  items PlaylistItem[]

  @@index([ownerId])
  @@index([isActive, sortOrder])
  @@map("playlists")
}

/// "I deleted this, stop showing it to me." Written when a member deletes a playlist
/// they had SAVED from a share, naming the SOURCE playlist — deleting the copy alone
/// would hand the card straight back, because the plays that put it in the history
/// sit on the source id and the source is still shared by its owner.
///
/// A row here, not a DELETE of the listening sessions: `listening_session` also feeds
/// streak and lifetime counters, so erasing rows to tidy one list would quietly move
/// numbers that have nothing to do with playlists.
///
/// `dismissedAt` is what keeps this from being a permanent block — a play newer than
/// it wins, so a member who goes back to the share link sees the playlist again. No FK
/// on `playlistId`: the source may be deleted later, and a dangling row simply matches
/// nothing.
model PlaylistHistoryDismissal {
  memberId    String   @map("member_id") @db.Uuid
  playlistId  String   @map("playlist_id") @db.Uuid
  dismissedAt DateTime @default(now()) @map("dismissed_at")

  @@id([memberId, playlistId])
  @@map("playlist_history_dismissals")
}

/// One audio in a playlist, in `order`. Cascades from Lesson on purpose: when the
/// content team removes a lesson the item disappears and the playlist lives on.
model PlaylistItem {
  id         String @id @default(uuid(7)) @db.Uuid
  playlistId String @map("playlist_id") @db.Uuid
  /// The slide inside `lesson.slides_data` that this item plays. Deliberately the
  /// SAME name and id space as `listening_session.audio_id`, so an item and the
  /// sessions it produced join on equal terms — one name for one id, even though
  /// "audio" is not strictly accurate (9% of tracked slides are VideoTemplate: a
  /// Bunny "audio" is a video of a still image). A second name for the same value
  /// would be worse than an imprecise shared one.
  audioId    String @map("audio_id")
  /// Denormalised owner of that slide. Carries the FK — a slide id lives inside JSON
  /// and cannot have one — which is what gives ON DELETE CASCADE, and what makes the
  /// section → course join (entitlement, name, duration) a join instead of a scan.
  lessonId   String @map("lesson_id") @db.Uuid
  order      Int    @default(0)

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  lesson   Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([playlistId, audioId])
  @@index([playlistId, order])
  @@index([lessonId])
  @@map("playlist_items")
}

