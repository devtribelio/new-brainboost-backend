model ReportCategory {
  id        String   @id @default(uuid(7)) @db.Uuid
  legacyId  Int?     @unique @map("legacy_id")
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  postReports   PostReport[]
  memberReports MemberReport[]

  @@map("report_categories")
}

enum ReportStatus {
  REPORTED
  REVIEWED
  RESOLVED
  DISMISSED
}

model MemberReport {
  id           String       @id @default(uuid(7)) @db.Uuid
  reporterId   String       @map("reporter_id") @db.Uuid
  targetId     String       @map("target_id") @db.Uuid
  categoryId   String       @map("category_id") @db.Uuid
  networkId    String?      @map("network_id") @db.Uuid
  reason       String?
  reportStatus ReportStatus @default(REPORTED) @map("report_status")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  category ReportCategory @relation(fields: [categoryId], references: [id])

  @@index([targetId])
  @@index([reporterId])
