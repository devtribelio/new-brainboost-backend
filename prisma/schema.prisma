/// Affiliate program per produk. `code` = public-facing reference di link.
/// Source: legacy `network_account_product_affiliator` (simplified, single-tenant).
model AffiliateProgram {
  id        String   @id @default(uuid(7)) @db.Uuid
  legacyId  Int?     @unique @map("legacy_id")
  productId String?  @map("product_id") @db.Uuid
  code      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product      Product?              @relation(fields: [productId], references: [id])
  affiliators  MemberAffiliator[]
  commissions  AffiliateCommission[]
  visits       AffiliateVisit[]
  transactions CommerceTransaction[]

  @@index([productId])
  @@map("affiliate_programs")
}

/// Member terdaftar sebagai promoter program.
/// Source: legacy `member_product_affiliator` (simplified, no pixel/request).
model MemberAffiliator {
  id        String    @id @default(uuid(7)) @db.Uuid
  legacyId  Int?      @unique @map("legacy_id")
  memberId  String    @map("member_id") @db.Uuid
  programId String    @map("program_id") @db.Uuid
  exitState String?   @map("exit_state")
  exitAt    DateTime? @map("exit_at")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  member  Member           @relation("MemberAffiliatorMember", fields: [memberId], references: [id], onDelete: Cascade)
  program AffiliateProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  commissions  AffiliateCommission[]
  transactions CommerceTransaction[]

  @@unique([memberId, programId])
  @@index([programId])
  @@map("member_affiliators")
}

/// Commission ledger. 1 row per (payment, recipient, level).
/// Source: legacy `affiliator_commision`.
model AffiliateCommission {
  id                 String    @id @default(uuid(7)) @db.Uuid
  legacyId           Int?      @unique @map("legacy_id")
  recipientId        String    @map("recipient_id") @db.Uuid
  affiliatorId       String?   @map("affiliator_id") @db.Uuid
  programId          String?   @map("program_id") @db.Uuid
  productId          String?   @map("product_id") @db.Uuid
  paymentId          String?   @map("payment_id") @db.Uuid
  paymentLegacyId    Int?      @map("payment_legacy_id")
  buyerMemberId      String?   @map("buyer_member_id") @db.Uuid
  level              Int       @default(1)
  affiliateBased     String    @map("affiliate_based") // "PERFORMANCE" | "GROWTH" | "INACTIVE" snapshot
  schemaType         String?   @map("schema_type") // "SCHEMA_1" | "SCHEMA_2" | "SCHEMA_3" (PERFORMANCE only)
  productPrice       Int       @default(0) @map("product_price")
  voucherAmount      Int       @default(0) @map("voucher_amount")
  commissionRate     Int       @map("commission_rate") // % yang dipakai (20/30/40/10/5)
  amount             Int       @default(0) // priceRecipient
  status             String    @default("PENDING") // PENDING | BALANCE | VOIDED
  approvedAt         DateTime? @map("approved_at")
  voidedAt           DateTime? @map("voided_at")
  voidedBy           String?   @map("voided_by") @db.Uuid
  voidedReason       String?   @map("voided_reason")
  source             String? // DEEPLINK | WEB | INSTALL_REFERRER
  attributionVisitId String?   @map("attribution_visit_id") @db.Uuid
  channel            String? // payment channel: "xendit" | "revenuecat" | "scalev" | "lynkid" | null (legacy/web)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  recipient  Member            @relation("AffiliateCommissionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  affiliator MemberAffiliator? @relation(fields: [affiliatorId], references: [id])
  program    AffiliateProgram? @relation(fields: [programId], references: [id])
  product    Product?          @relation(fields: [productId], references: [id])

  @@unique([paymentId, recipientId, level], name: "uniq_payment_recipient_level")
  @@index([recipientId, createdAt])
  @@index([programId])
  @@index([buyerMemberId])
  @@index([status])
  @@index([status, channel])
  @@map("affiliate_commissions")
}

// Pre-aggregated monthly affiliate leaderboard (§11 / BB-121). Derived, read-only
// data — NOT a source of truth (no legacyId). A scheduled job recomputes it:
// SUM(amount) per recipient per WIB calendar month, status != VOIDED (PENDING and
// MIGRATED both count), ranked desc. The current month is fully recomputed each
// run (PENDING counted + refund->VOIDED means a rank can DROP); a past month is
// frozen once its commissions mature (7 days after month end) and never touched
// again. `frozen` is derived at read time (period vs now), not stored.
model AffiliateLeaderboardMonthly {
  id              String   @id @default(uuid(7)) @db.Uuid
  periodYear      Int      @map("period_year")
  periodMonth     Int      @map("period_month") // 1..12 (WIB calendar month)
  memberId        String   @map("member_id") @db.Uuid // commission recipient
  totalCommission Int      @default(0) @map("total_commission") // Σ amount, excl VOIDED (IDR)
  rank            Int // 1-based rank within the period
  updatedAt       DateTime @updatedAt @map("updated_at") // last aggregation run for this period

  member Member @relation("MemberLeaderboardEntries", fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([periodYear, periodMonth, memberId], map: "alm_period_member_key")
  @@index([periodYear, periodMonth, rank], map: "alm_period_rank_idx")
  @@map("affiliate_leaderboard_monthly")
}

/// Affiliate link click log. Marketing-grade tracking + sumber attribution.
model AffiliateVisit {
  id                 String   @id @default(uuid(7)) @db.Uuid
  programId          String?  @map("program_id") @db.Uuid
  affiliatorMemberId String   @map("affiliator_member_id") @db.Uuid
  memberId           String?  @map("member_id") @db.Uuid
  // Per-product attribution (B-5): the product the affiliate link pointed at
  // (OneLink carries product + affCode). null = product-less visit (web/program
  // link or legacy pre-B5). The per-purchase resolver prefers an exact-product
  // visit so a link for product X never attributes a different product Y.
  // Scalar (no relation) — only ever filtered on, never `include`d.
  productId          String?  @map("product_id") @db.Uuid
  // marketing
  utmSource          String?  @map("utm_source")
  utmMedium          String?  @map("utm_medium")
  utmCampaign        String?  @map("utm_campaign")
  utmContent         String?  @map("utm_content")
  utmTerm            String?  @map("utm_term")
  adId               String?  @map("ad_id")
  adNetwork          String?  @map("ad_network") // "google" | "meta" | "tiktok"
  // device
  ipAddress          String?  @map("ip_address")
  userAgent          String?  @map("user_agent")
  referer            String?
  deviceId           String?  @map("device_id")
  platform           String? // "ios" | "android" | "web"
  appVersion         String?  @map("app_version")
  installReferrer    String?  @map("install_referrer")
  // raw escape-hatch
  rawQueryString     String?  @map("raw_query_string")
  rawHeaders         Json?    @map("raw_headers")
  // idempotency
  clientEventId      String?  @unique @map("client_event_id")
  createdAt          DateTime @default(now()) @map("created_at")

  program    AffiliateProgram? @relation(fields: [programId], references: [id])
  affiliator Member            @relation("AffiliateVisitAffiliator", fields: [affiliatorMemberId], references: [id])

  @@index([programId, createdAt])
  @@index([affiliatorMemberId, createdAt])
  @@index([memberId])
  @@index([memberId, productId, createdAt]) // per-product last-touch lookup (B-5)
  @@index([adId])
  @@index([utmCampaign])
  @@map("affiliate_visits")
}

/// Affiliate payout request. Ledger debit against cleared (BALANCE) commissions.
/// Source: legacy `disbursement_payment_affiliate` / TBDisbursement::affiliate.
model AffiliateDisbursement {
  id            String  @id @default(uuid(7)) @db.Uuid
  memberId      String  @map("member_id") @db.Uuid
  grossAmount   Int     @default(0) @map("gross_amount") // withdrawable balance consumed by this payout
  fee           Int     @default(0) // flat platform fee
  netAmount     Int     @default(0) @map("net_amount") // paid to member = gross - fee
  // PENDING (awaiting manual approval) | PROCESSING (Xendit called, awaiting callback) | PAID | FAILED | REJECTED | VOIDED
  status        String  @default("PENDING")
  mode          String? // AUTO | MANUAL — how this payout was routed (see TBWithdraw::validateStatus parity)
  provider      String? // "xendit"
  providerRef   String? @map("provider_ref") // provider disbursement id
  externalId    String? @unique @map("external_id") // our idempotency key sent to Xendit; callback matches on this
  failureReason String? @map("failure_reason")

  // Bank snapshot at request time (member profile bank may change later).
  bankCode          String? @map("bank_code")
  bankAccountNumber String? @map("bank_account_number")
  bankAccountName   String? @map("bank_account_name")

  // Approval audit (MANUAL flow, or AUTO self-approval timestamp).
  approvedBy     String?   @map("approved_by") @db.Uuid
  approvedAt     DateTime? @map("approved_at")
  rejectedReason String?   @map("rejected_reason")

  requestedAt DateTime  @default(now()) @map("requested_at")
  paidAt      DateTime? @map("paid_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  member Member @relation("MemberDisbursements", fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, status])
  @@index([status])
  @@map("affiliate_disbursements")
}

// ============================================================================
// Commerce / Purchase (Xendit-only; CC + VA + eWallet; no IAP, no cart, no shipping)
// See docs/commerce-port.md
// ============================================================================

enum CommerceTransactionStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
  REFUNDED
  CANCELED
}

enum CommercePaymentStatus {
  PENDING
  SUCCESS
  EXPIRED
  FAILED
  CANCELED
}

/// Order header. Snapshot price + voucher + attribution at checkout time.
model CommerceTransaction {
  id                           String                    @id @default(uuid(7)) @db.Uuid
  legacyId                     Int?                      @unique @map("legacy_id")
  code                         String                    @unique // BB-YYYYMMDD-####
  memberId                     String                    @map("member_id") @db.Uuid
  productId                    String                    @map("product_id") @db.Uuid
  qty                          Int                       @default(1) // reserved; always 1 for course MVP
  itemTotal                    Int                       @default(0) @map("item_total")
  shippingTotal                Int                       @default(0) @map("shipping_total") // reserved; 0 for course MVP
  feeTotal                     Int                       @default(0) @map("fee_total")
  voucherAmount                Int                       @default(0) @map("voucher_amount")
  // Unused portion of a subscription term credited back on an upgrade. Reduces
  // `amount` exactly like a voucher does, so the affiliate base (which is
  // derived from what was actually paid) follows without extra plumbing.
  prorationCredit              Int                       @default(0) @map("proration_credit")
  amount                       Int                       @default(0) // grand total
  voucherCode                  String?                   @map("voucher_code")
  voucherId                    String?                   @map("voucher_id") @db.Uuid
  affiliatorId                 String?                   @map("affiliator_id") @db.Uuid
  programId                    String?                   @map("program_id") @db.Uuid
  // Per-purchase commission override: the Member behind the affiliate link used at THIS
  // checkout. When set, commission for this purchase goes to this member (and up their
  // chain), superseding the buyer's permanent inviter. No cookie persistence — per-checkout.
  attributedAffiliatorMemberId String?                   @map("attributed_affiliator_member_id") @db.Uuid
  // Multi-channel ingestion (IAP/Scalev/Lynk.id via /ingest/purchase). Null for native web checkout.
  provider                     String? // = ThirdPartyCredential.name
  providerEventId              String?                   @map("provider_event_id") // provider's event/txn id — idempotency
  // Commission idempotency key (B-2): stable across re-settles (Apple original_transaction_id).
  // Audit/forensics + lets the cleanup job map a stray commission back to its purchase.
  attributionKey               String?                   @map("attribution_key")
  // Tracking-link attribution (shop web). Snapshot of the visitor's `bb_attr`
  // cookie at checkout, FROZEN — never updated. The cookie is last-touch, so a
  // report joining shop_visits by guest_id would retro-move a paid order to a
  // later campaign. Reporting-only: these NEVER feed commission (that stays
  // `attributedAffiliatorMemberId` + AffiliateVisit). NULL = no source; the
  // report renders "direct", the column does not store it, so "FE never sent
  // it" stays distinguishable from "genuinely direct".
  utmSource                    String?                   @map("utm_source")
  utmMedium                    String?                   @map("utm_medium")
  utmCampaign                  String?                   @map("utm_campaign")
  utmContent                   String?                   @map("utm_content")
  utmTerm                      String?                   @map("utm_term")
  guestId                      String?                   @map("guest_id")
  status                       CommerceTransactionStatus @default(PENDING)
  paidAt                       DateTime?                 @map("paid_at")
  canceledAt                   DateTime?                 @map("canceled_at")
  expiredAt                    DateTime?                 @map("expired_at")
  createdAt                    DateTime                  @default(now()) @map("created_at")
  updatedAt                    DateTime                  @updatedAt @map("updated_at")

  member     Member            @relation(fields: [memberId], references: [id])
  product    Product           @relation(fields: [productId], references: [id])
  affiliator MemberAffiliator? @relation(fields: [affiliatorId], references: [id])
  program    AffiliateProgram? @relation(fields: [programId], references: [id])
  voucher    Voucher?          @relation(fields: [voucherId], references: [id])
  payments   CommercePayment[]

  @@unique([provider, providerEventId]) // idempotent ingest; both null for web (NULLs distinct in PG)
  @@index([memberId, createdAt])
  @@index([status])
  @@index([expiredAt])
  @@index([utmSource, utmCampaign, createdAt]) // Sumber Traffic report
  @@map("commerce_transactions")
}

/// Commission "first settle wins" claim (B-2). One row per underlying purchase,
/// keyed by (provider, attributionKey = Apple original_transaction_id). The unique
/// constraint makes commission attribution idempotent across re-settles that mint a
/// fresh providerEventId/paymentId (delete+rebuy, renewal, restore, RC re-sync burst):
/// the first ingest inserts and pays commission; later ones hit P2002 → enrollment
/// only, no double-pay. Race-proof under a concurrent burst (exactly one insert wins).
model AffiliateAttributionClaim {
  id             String   @id @default(uuid(7)) @db.Uuid
  provider       String // = ThirdPartyCredential.name
  attributionKey String   @map("attribution_key")
  paymentId      String   @map("payment_id") @db.Uuid // the payment that won the claim (audit)
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([provider, attributionKey])
  @@map("affiliate_attribution_claims")
}

/// Payment attempt. Multi rows per transaction (VA retry possible after expiry).
model CommercePayment {
  id                    String                @id @default(uuid(7)) @db.Uuid
  legacyId              Int?                  @unique @map("legacy_id")
  transactionId         String                @map("transaction_id") @db.Uuid
  // Conditional-uniqueness guard: holds `transactionId` while this payment occupies the
  // transaction's active slot (status PENDING or SUCCESS); NULL once EXPIRED/FAILED/CANCELED
  // so a retry can reclaim the slot. The @unique index lets Postgres reject a second
  // concurrent active payment for the same transaction (NULLs are distinct → retries allowed).
  activeSlotTxId        String?               @unique @map("active_slot_tx_id") @db.Uuid
  memberId              String                @map("member_id") @db.Uuid
  paymentType           String                @map("payment_type") // "cc" | "va" | "eWallet" | "voucher"
  bank                  String? // BCA / BNI / MANDIRI / BRI / PERMATA
  ewalletType           String?               @map("ewallet_type") // OVO / DANA / LINKAJA / GOPAY / SHOPEEPAY
  // `amount` / `acceptedAmount` are ALWAYS IDR minor-unit-free integers, including for
  // foreign-storefront IAP: the ingest layer converts before writing, so every downstream
  // consumer (commission base, reporting, transaction history) stays currency-blind.
  amount                Int
  fee                   Int                   @default(0)
  acceptedAmount        Int                   @default(0) @map("accepted_amount")
  // FX snapshot — populated ONLY when the purchase was settled in a non-IDR currency
  // (RevenueCat storefronts outside Indonesia). `currency` is the buyer's storefront
  // currency, `amountLocal` what they actually paid in it, `amountUsd` RevenueCat's own
  // USD figure (the bridge we convert through), `fxRateIdr` the USD→IDR rate this row was
  // converted with, and `fxRateSource` which layer of the resolution chain answered.
  // Kept per-row, not in a rates table: the rate a payment used must stay reproducible
  // even after the live rate has moved on.
  currency              String?               @default("IDR")
  amountLocal           Decimal?              @map("amount_local") @db.Decimal(18, 4)
  amountUsd             Decimal?              @map("amount_usd") @db.Decimal(18, 4)
  fxRateIdr             Decimal?              @map("fx_rate_idr") @db.Decimal(18, 6)
  fxRateSource          String?               @map("fx_rate_source")
  status                CommercePaymentStatus @default(PENDING)
  vendorStatus          String?               @map("vendor_status")
  externalId            String?               @map("external_id")
  xenditId              String?               @unique @map("xendit_id") // pr-xxx (PaymentRequest id)
  xenditPaymentMethodId String?               @map("xendit_payment_method_id") // pm-xxx (PaymentMethod id from SDK)
  paymentMethodId       String?               @map("payment_method_id") // pm-xxx supplied by mobile for CC charges
  vaNumber              String?               @map("va_number")
  checkoutUrl           String?               @map("checkout_url") // eWallet WEB/MOBILE AUTH redirect (webview fallback)
  deeplinkUrl           String?               @map("deeplink_url") // eWallet DEEPLINK AUTH (open native eWallet app)
  cardMaskedNumber      String?               @map("card_masked_number")
  cardBrand             String?               @map("card_brand")
  expiredAt             DateTime?             @map("expired_at")
  paidAt                DateTime?             @map("paid_at")
  logRequest            Json?                 @map("log_request")
  logResponse           Json?                 @map("log_response")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  transaction CommerceTransaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  member      Member                 @relation(fields: [memberId], references: [id])
  events      CommercePaymentEvent[]

  @@index([transactionId])
  @@index([status, expiredAt])
  @@map("commerce_payments")
}

/// Audit trail of payment status transitions. Useful for Xendit re-delivery debugging.
model CommercePaymentEvent {
  id         String                 @id @default(uuid(7)) @db.Uuid
  paymentId  String                 @map("payment_id") @db.Uuid
  source     String // "checkout" | "webhook" | "poll" | "manual"
  fromStatus CommercePaymentStatus? @map("from_status")
  toStatus   CommercePaymentStatus  @map("to_status")
  payload    Json?
  createdAt  DateTime               @default(now()) @map("created_at")

  payment CommercePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@map("commerce_payment_events")
}

/// Discount voucher. Legacy `voucher` table parity.
model Voucher {
  id        String    @id @default(uuid(7)) @db.Uuid
  legacyId  Int?      @unique @map("legacy_id")
  code      String    @unique
  type      String // "PERCENT" | "AMOUNT" | "TRIAL"
  value     Int
  maxAmount Int?      @map("max_amount") // cap for PERCENT
  // TRIAL only: days of course access granted. The discount is always 100% (the
  // order settles through the existing amount=0 voucher bypass), so `value` is
  // ignored for TRIAL and the duration is what the voucher actually configures.
  // DB CHECK enforces > 0 when type='TRIAL'. Once-per-member is NOT enforced here:
  // the record of "this member already trialed on this voucher" is the enrollment
  // row's `via_voucher_id` (see CourseEnrollment), so `voucher_redemptions` keeps
  // its original shape and the quota/idempotency machinery is untouched.
  trialDays Int?      @map("trial_days")
  quota     Int? // null = unlimited
  used      Int       @default(0)
  startsAt  DateTime? @map("starts_at")
  endsAt    DateTime? @map("ends_at")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Product scope whitelist: 0 rows = global (all products), >=1 rows = only those
  // products (VoucherService.validate). Replaced the old single nullable product_id
  // column (migration 20260719120000_voucher_multi_product).
  products     VoucherProduct[]
  transactions CommerceTransaction[]

  @@map("vouchers")
}

/// Junction: which products a voucher applies to. No rows = voucher is global.
model VoucherProduct {
  voucherId String  @map("voucher_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([voucherId, productId])
  @@map("voucher_products")
}

/// Idempotency guard for voucher redemption. One row per order (CommerceTransaction)
/// that consumed the voucher, so a redelivered `commerce.payment.success` (Xendit
/// webhook retry / event re-emit) cannot double-increment `vouchers.used`. No FK —
/// mirrors AffiliateAttributionClaim; the unique(transactionId) IS the guard. The
/// first redeem for an order inserts here and bumps `used`; redelivery hits P2002 → no-op.
model VoucherRedemption {
  id            String   @id @default(uuid(7)) @db.Uuid
  voucherId     String   @map("voucher_id") @db.Uuid
  transactionId String   @unique @map("transaction_id") @db.Uuid // one redemption per order
  paymentId     String?  @map("payment_id") @db.Uuid // audit: payment that triggered it
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([voucherId])
  @@map("voucher_redemptions")
}

// ============================================================================
// Admin (separate from Member — isolated admin panel auth)
// ============================================================================

enum AdminRole {
  SUPERADMIN
  ADMIN
}

model Admin {
  id           String    @id @default(uuid(7)) @db.Uuid
  email        String    @unique
  fullName     String    @map("full_name")
  passwordHash String    @map("password_hash")
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("admins")
}

/// Runtime-configurable key-value settings. Change without redeploy (cached, short TTL).
/// e.g. affiliate.cookieDays, affiliate.holdDays. Edit via DB/admin; takes effect within cache TTL.
model AppSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("app_settings")
}

/// Force/soft update config for the mobile app, ONE ROW PER PLATFORM. Drives
/// `GET /api/app/version-check` — replaces the app's Supabase `mobile_version_config`
/// and its store-listing scrape, so this table is the sole source of the update verdict.
/// Verdict: version < forceBelow -> force, else version < latestVersion -> soft, else none.
/// Missing row = "none" (fail-safe). Edited by ops via SQL / backoffice-bb; cached ~60s.
model AppVersionConfig {
  platform      String   @id // "android" | "ios"
  latestVersion String   @map("latest_version") // semver; soft-update threshold + informational
  forceBelow    String?  @map("force_below") // semver; null = force disabled. Keep <= latestVersion
  storeUrl      String?  @map("store_url") // optional override; app v1 uses its native store redirect
  softMessage   String?  @map("soft_message") // dialog body for the soft verdict; null = app default copy
  forceMessage  String?  @map("force_message") // dialog body for the force verdict; null = app default copy
  updatedAt     DateTime @updatedAt @map("updated_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("app_version_configs")
}

/// Auth + per-channel capability toggles for 3rd-party ingestion (IAP/Scalev/Lynk.id) via
/// POST /ingest/purchase. Key is stored hashed. Toggles are plain booleans (easy manual edit).
model ThirdPartyCredential {
  id                String    @id @default(uuid(7)) @db.Uuid
  name              String    @unique // "revenuecat", "scalev", "lynkid"
  keyHash           String    @unique @map("key_hash") // hash of the API key (never store plaintext)
  isActive          Boolean   @default(true) @map("is_active") // master on/off
  triggersAffiliate Boolean   @default(false) @map("triggers_affiliate") // may generate affiliate commission (SAFE DEFAULT off)
  canIngestRefund   Boolean   @default(false) @map("can_ingest_refund") // may void commissions on refund events
  lastUsedAt        DateTime? @map("last_used_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("third_party_credentials")
}

// ---------------------------------------------------------------------------
// Legacy resync (transition period): incremental sync of already-migrated data
// from legacy MariaDB into Postgres. See docs/legacy-resync-plan.md.
// ---------------------------------------------------------------------------

// Per-syncer watermark + last-run stats. One row per syncer ("members",
// "enrollments", "commissions", "kyc", "tree", "reviews", "posts").
model SyncState {
  syncer    String    @id // syncer name
  watermark String? // max processed COALESCE(updated, created), ISO datetime string
  lastRunAt DateTime? @map("last_run_at")
  lastStats Json?     @map("last_stats") // { scanned, upserted, skipped, voided, errors }
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("sync_state")
}

// Durable dedup map (loser legacy member id -> winner legacy member id). Replaces
// the gitignored scripts/member-redirect.json so resync re-points dangling legacy
// member refs consistently across runs. Append-only.
model MemberRedirect {
  loserLegacyId  Int      @id @map("loser_legacy_id")
  winnerLegacyId Int      @map("winner_legacy_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([winnerLegacyId])
  @@map("member_redirect")
}

// ============================================================================
// Subscription (Phase 1: annual) — see docs/prd-subscription-backend.md
// ============================================================================

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELED
}

/// Subscription tier definition, 1:1 with a Product (type='subscription').
/// Price intentionally lives on Product so checkout/voucher/Xendit paid-amount
/// verification reuse the commerce path unchanged. Phase 2/3 (6-month, monthly)
/// = new rows here, zero-code.
model SubscriptionPlan {
  id                   String   @id @default(uuid(7)) @db.Uuid
  productId            String   @unique @map("product_id") @db.Uuid
  code                 String   @unique // SOLO_12M | DUO_12M | FAMILY_12M | PREMIUM_12M
  tier                 String // SOLO | DUO | FAMILY | PREMIUM
  periodMonths         Int      @map("period_months")
  seatCount            Int      @map("seat_count") // seat 1 = owner
  affiliateRate        Int      @map("affiliate_rate") // % flat L1 commission on first sale (40)
  renewalAffiliateRate Int      @map("renewal_affiliate_rate") // % on renewals AND tier changes (10, COO 2026-08-24); runtime-editable
  isActive             Boolean  @default(true) @map("is_active")
  sortOrder            Int      @default(0) @map("sort_order")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  product       Product              @relation(fields: [productId], references: [id])
  subscriptions MemberSubscription[]

  @@map("subscription_plans")
}

/// One row per owner-side subscription. Entitlement predicate: a member holds a
/// seat on a sub with status=ACTIVE and coalesce(graceUntil, expiresAt) > now.
/// Partial unique (manual SQL in migration — Prisma can't express it):
///   uniq_active_sub_per_owner ON (owner_id) WHERE status = 'ACTIVE'
model MemberSubscription {
  id                  String             @id @default(uuid(7)) @db.Uuid
  ownerId             String             @map("owner_id") @db.Uuid
  planId              String             @map("plan_id") @db.Uuid
  status              SubscriptionStatus @default(ACTIVE)
  expiresAt           DateTime           @map("expires_at")
  graceUntil          DateTime?          @map("grace_until") // expiresAt + app_settings subscription.graceDays
  canceledAt          DateTime?          @map("canceled_at") // cancel-INTENT (auto-renew off); access continues until expiry
  // Scheduled tier change (downgrade only — an upgrade is applied on the spot).
  // Declared any time, applied by the renewal that bills the new plan. Plain
  // scalar planId, no FK: a plan row is never deleted, and the pointer is
  // cleared on apply/cancel anyway.
  pendingPlanId       String?            @map("pending_plan_id") @db.Uuid
  pendingEffectiveAt  DateTime?          @map("pending_effective_at") // = expiresAt when declared
  pendingSource       String?            @map("pending_source") // revenuecat | web — who owns the cancel path
  pendingDeclaredAt   DateTime?          @map("pending_declared_at")
  source              String // xendit | revenuecat | granted
  providerRef         String?            @map("provider_ref") // RC original_transaction_id — EXPIRATION/CANCELLATION webhook lookup
  latestTransactionId String?            @map("latest_transaction_id") @db.Uuid
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  owner        Member                    @relation("MemberSubscriptionOwner", fields: [ownerId], references: [id])
  plan         SubscriptionPlan          @relation(fields: [planId], references: [id])
  seats        SubscriptionSeat[]
  activations  SubscriptionActivation[]
  reminderLogs SubscriptionReminderLog[]

  @@index([ownerId])
  @@index([providerRef])
  @@index([status, expiresAt])
  @@map("member_subscriptions")
}

/// Pre-provisioned seat slots (Spotify-Family model): activation creates seatCount
/// rows up front; seat 1 is claimed by the owner, the rest sit empty (memberId null)
/// until claimed by invite code. Claim = conditional UPDATE on (inviteCode, memberId
/// IS NULL); the code is single-use (nulled after claim). Partial unique (manual SQL):
///   uniq_active_seat_per_member ON (member_id) WHERE member_id IS NOT NULL
model SubscriptionSeat {
  id             String    @id @default(uuid(7)) @db.Uuid
  subscriptionId String    @map("subscription_id") @db.Uuid
  seatNo         Int       @map("seat_no") // 1 = owner
  memberId       String?   @map("member_id") @db.Uuid // null = empty slot
  // Owner's pick of who survives a pending downgrade. Kept on the SEAT so a
  // member who leaves before the change lands drops out of the selection for
  // free — a list stored on the subscription would go stale instead.
  pendingKeep    Boolean   @default(false) @map("pending_keep")
  inviteCode     String?   @unique @map("invite_code") // crypto-random, single-use, rotated by generateInvite
  claimedAt      DateTime? @map("claimed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  subscription MemberSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  member       Member?            @relation("SubscriptionSeatMember", fields: [memberId], references: [id])

  @@unique([subscriptionId, seatNo])
  @@index([memberId])
  @@map("subscription_seats")
}

/// Idempotency ledger + audit trail: one append-only row per expiry-affecting change.
/// Webhook redelivery (Xendit retry / RC re-emit) re-hits the unique transactionId →
/// P2002 → no-op, so expiry is never double-extended. transactionId is null for grants,
/// hence the partial unique (manual SQL):
///   uniq_activation_tx ON (transaction_id) WHERE transaction_id IS NOT NULL
/// No FK on transactionId by design (mirrors AffiliateAttributionClaim).
model SubscriptionActivation {
  id                String    @id @default(uuid(7)) @db.Uuid
  subscriptionId    String    @map("subscription_id") @db.Uuid
  kind              String // initial | renewal | grant | plan_change
  source            String // xendit | revenuecat | granted
  transactionId     String?   @map("transaction_id") @db.Uuid // CommerceTransaction.id; null for grants
  providerRef       String?   @map("provider_ref")
  previousExpiresAt DateTime? @map("previous_expires_at")
  newExpiresAt      DateTime  @map("new_expires_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  subscription MemberSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
  @@map("subscription_activations")
}

/// Dedupe for the renewal-reminder job (insert-first): the unique key includes
/// expiresAt, so a renewal (which moves expiresAt) automatically re-arms the next
/// cycle's reminders without any cleanup.
model SubscriptionReminderLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  subscriptionId String   @map("subscription_id") @db.Uuid
  expiresAt      DateTime @map("expires_at") // the expiry cycle this reminder targeted
  daysBefore     Int      @map("days_before") // 7 | 3 | 1 (from app_settings subscription.reminderDaysBefore)
  createdAt      DateTime @default(now()) @map("created_at")

  subscription MemberSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, expiresAt, daysBefore])
  @@map("subscription_reminder_logs")
}

/// Tracking-link visit on the shop web (`brainboost-marketplace`).
/// Deliberately NOT AffiliateVisit: that table requires an affiliator
/// (`affiliator_member_id` NOT NULL) and is read by the commission resolver, so
/// a UTM-only webinar click cannot be written there and loosening it would put
/// non-payout rows in the payout path. Reporting-only table; no FK to Member or
/// Product so a delete on either can never block a visit write.
model ShopVisit {
  id            String   @id @default(uuid(7)) @db.Uuid
  guestId       String   @map("guest_id")
  memberId      String?  @map("member_id") @db.Uuid
  productId     String?  @map("product_id") @db.Uuid
  utmSource     String?  @map("utm_source")
  utmMedium     String?  @map("utm_medium")
  utmCampaign   String?  @map("utm_campaign")
  utmContent    String?  @map("utm_content")
  utmTerm       String?  @map("utm_term")
  referer       String?
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  /// Client-generated per-send id. Dedupes RETRIES, not visits: a refresh sends
  /// a new id and must produce a new row (Kunjungan counts rows, Pengunjung unik
  /// counts distinct guest_id).
  clientEventId String?  @unique @map("client_event_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([guestId, createdAt])
  @@index([memberId])
  @@index([utmSource, utmCampaign, createdAt])
  @@index([createdAt])
  @@map("shop_visits")
}

/// Named tracking link for a shop product page ("Webinar 17 September"),
/// authored in the backoffice and copied into a broadcast by hand.
///
/// Legacy had this feature as `product_custom_url` (Studio > Product > Tracking):
/// name, slug, all five UTM columns, and two shortlinks from an in-house
/// shortener. The Consolidated report still reads its remains today — the
/// "Webinar" channel bucket means `product_custom_url.name LIKE 'Webinar%'`.
///
/// NOTHING in this app reads these rows today: there is no shortlink redirect
/// yet, and order attribution is frozen from the shop cookie at checkout, not
/// from here. It lives in Prisma anyway because the schema is the single source
/// of truth for every table in this database, and because the redirect, when it
/// is built, belongs on this side (`GET /s/:slug`) — the alternative was a
/// `bo_`-prefixed table that a Prisma app would later have to reach into with
/// $queryRaw.
///
/// Writer today is the backoffice, over plain SQL. Two consequences: `id` must
/// be supplied by the writer (`@default(uuid(7))` is generated by Prisma Client,
/// not by Postgres), and `updatedAt` must be written explicitly for the same
/// reason.
model TrackingLink {
  id           String   @id @default(uuid(7)) @db.Uuid
  /// Operator-facing label. Shown on the Sumber Traffic report in place of the
  /// raw UTM pair; never part of the grouping key.
  name         String
  /// Shortlink path segment, served by `GET /s/:slug`. UNIQUE globally, unlike
  /// `utmCampaign` which is only unique per source — `webinar/limitless` and
  /// `email/limitless` are both legal campaigns but cannot share a slug.
  slug         String   @unique
  /// Scalar, no relation and no FK — deliberately, exactly like AffiliateVisit
  /// and ShopVisit: a campaign that happened is a record, and deleting a product
  /// must neither fail nor erase the link's history.
  productId    String   @map("product_id") @db.Uuid
  utmSource    String   @map("utm_source")
  utmMedium    String?  @map("utm_medium")
  /// The report groups on (utmSource, utmCampaign), so the pair is UNIQUE: two
  /// links sharing it would silently merge into one row and mix their numbers,
  /// with nothing on screen to say it happened. Inactive links are included in
  /// the constraint — their traffic stays in the report, so their campaign must
  /// never be reused.
  utmCampaign  String   @map("utm_campaign")
  utmContent   String?  @map("utm_content")
  utmTerm      String?  @map("utm_term")
  /// Appended as `?voucher=` on the built URL.
  voucherCode  String?  @map("voucher_code")
  note         String?
  isActive     Boolean  @default(true) @map("is_active")
  /// `bo_users.id` — a backoffice-owned table, so no FK can point at it from
  /// here. The email is kept alongside so an audit still reads correctly after
  /// that user is deleted.
  createdBy    String?  @map("created_by") @db.Uuid
  createdEmail String?  @map("created_email")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  clicks TrackingLinkClick[]

  @@unique([utmSource, utmCampaign])
  @@index([productId])
  @@index([createdAt])
  @@map("tracking_links")
}

/// Shortlink clicks, aggregated per link per day.
///
/// A row per click would be the obvious shape and the wrong one: nothing reads an
/// individual click, the volume is unbounded during a broadcast, and there is no
/// prune job to trim it. One upserted counter per (link, day) answers every
/// question the report asks — the total, and the shape over time — at a fixed row
/// count. Mirrors legacy `product_custom_url_tracking.count_visit`.
///
/// Days are WIB (computed at write time), matching how every date on the report is
/// rendered: a click at 01:00 WIB belongs to that night, not to the day before.
///
/// Clicks are NOT visits. A click that never reaches the shop (connection dropped,
/// or a scanner that follows the redirect but runs no JS) never becomes a
/// `shop_visits` row, so the gap between the two columns is real information and
/// the two are never merged.
model TrackingLinkClick {
  linkId String   @map("link_id") @db.Uuid
  /// Calendar day in WIB.
  day    DateTime @db.Date
  count  Int      @default(0)

  link TrackingLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@id([linkId, day])
  @@index([day])
  @@map("tracking_link_clicks")
}
